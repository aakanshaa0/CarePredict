<!DOCTYPE html>
<html>
<head>
    <title>Footer</title>
    <link rel="stylesheet" href="footer.css">
</head>
<body>
    <footer>
        <div class="footer-container">
            <div class="footer-column">
                <div class="logo">
                    <i class="fa-solid fa-heart-pulse"></i> <!-- Font Awesome heart-pulse icon -->
                    <p>"Empowering healthcare with innovation, excellence, and a patient-first approach to ensure quality, accessibility, and compassionate care for all."</p>
                </div>
                <div class="social-icons">
                    <i class="fab fa-facebook"></i>
                    <i class="fab fa-instagram"></i>
                </div>
            </div>
            <div class="footer-column">
                <h3 class="footer-title"><i class="fas fa-user-md"></i> Medical Services</h3>
                <ul>
                    <li>Emergency Care</li>
                    <li>Primary Care</li>
                    <li>Specialist Care</li>
                    <li>Laboratory Services</li>
                </ul>
            </div>
            <div class="footer-column">
                <h3 class="footer-title"><i class="fas fa-notes-medical"></i> Patient Resources</h3>
                <ul>
                    <li>Patient Portal</li>
                    <li>Find a doctor</li>
                    <li>Medical Records</li>
                    <li>Insurance Information</li>
                    <li>Patient Education</li>
                </ul>
            </div>
            <div class="footer-column">
                <h3 class="footer-title"><i class="fas fa-phone-alt"></i> Contact & Hours</h3>
                <p><i class="fas fa-map-marker-alt"></i>456 Wellness Street<br>
                    Healthcare Hub, NY 56789</p>
                <p><i class="fas fa-phone"></i> <a href="tel:1-800-HEALTH-CARE">1-800-HEALTH-CARE</a></p>
                <p>Mon-Fri: 8:00 AM - 8:00 PM <br> Sat-Sun: 9:00 AM - 5:00 PM <br> <span class="emergency">Emergency: 24/7</span></p>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="footer-links">
                <a href="#">Privacy Policy</a>
                <a href="#">Terms of Service</a>
                <a href="#">Accessibility</a>
            </div>
        </div>
        <div class="footer-emergency">
            <p><i class="fas fa-phone"></i> <a href="tel:1-800-HEALTH-CARE">1-800-HEALTH-CARE</a></p>
            <p>Always Available for Your Care</p>
        </div>
    </footer>
