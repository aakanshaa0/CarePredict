<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cancer Information</title>
    <link rel="stylesheet" href="/analysis.css">
</head>
<body>
    <div class="container" id="cancer-info">
        <h2>Cancer Information</h2>
        <p>
            Cancer is a group of diseases involving abnormal cell growth with the potential to invade or spread to other parts of the body. 
            There are over 100 types of cancer, including breast cancer, lung cancer, prostate cancer, and more.
        </p>
        <div class="dropdown-container">
            <label for="cancer-types">Select a type of cancer:</label>
            <div class="custom-dropdown">
                <select id="cancer-types" name="cancer-types">
                    <option value="breast" selected>Breast Cancer</option>
                    <option value="lung">Lung Cancer</option>
                    <option value="prostate">Prostate Cancer</option>
                    <option value="skin">Skin Cancer</option>
                    <option value="colon">Colon Cancer</option>
                </select>
                <span class="dropdown-icon">▼</span>
            </div>
        </div>
        <a href="/cancer-analysis" class="btn">Proceed to Analysis</a>
    </div>

    <script>
        const dropdownHeader = document.getElementById('dropdown-header');
        const dropdownOptions = document.getElementById('dropdown-options');
        dropdownHeader.addEventListener('click', () => {
            dropdownOptions.classList.toggle('show');
        });
        dropdownOptions.querySelectorAll('li').forEach(option => {
            option.addEventListener('click', () => {
                dropdownHeader.querySelector('span').textContent = option.textContent;
                dropdownOptions.classList.remove('show');
            });
        });
    </script>
</body>
</html>